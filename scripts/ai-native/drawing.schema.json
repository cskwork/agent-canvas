{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "elements"],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "x", "y", "width", "height"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "type": {
            "enum": ["rectangle", "ellipse", "diamond", "text", "arrow", "line"]
          },
          "x": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          },
          "y": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          },
          "width": {
            "type": "number",
            "minimum": 1,
            "maximum": 4000
          },
          "height": {
            "type": "number",
            "minimum": -4000,
            "maximum": 4000
          },
          "text": {
            "type": "string",
            "maxLength": 2000
          },
          "label": {
            "type": "string",
            "maxLength": 2000
          },
          "fromId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "toId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "strokeColor": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "backgroundColor": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "fillStyle": {
            "enum": ["hachure", "solid", "cross-hatch"]
          },
          "strokeStyle": {
            "enum": ["solid", "dashed", "dotted"]
          },
          "roughness": {
            "enum": [0, 1, 2]
          },
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    }
  }
}
